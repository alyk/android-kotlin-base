graph TB
%% ===== FIRST ROW: App Module (Entry Point) =====
    APP_CLASS["Test23Application<br/>@HiltAndroidApp"]
    ACTIVITY["MainActivity<br/>@AndroidEntryPoint"]
    THEME["Test23Theme<br/>Material3"]

    APP_CLASS --> ACTIVITY
    ACTIVITY --> THEME

%% ===== SECOND ROW: Navigation =====
    NAV_HOST["NavHost<br/>navigation-compose"]
    BOTTOM_NAV["BottomNavBar<br/>Discover | Search | Favourites"]

    ACTIVITY --> NAV_HOST
    BOTTOM_NAV --> NAV_HOST

%% ===== THIRD ROW: Presentation Layer =====
    subgraph PRES["Presentation Layer (Feature Modules)"]
        direction LR

        subgraph DISCOVER["feature:discover"]
            DISCOVER_UI["DiscoverScreen<br/>@Composable"]
            DISCOVER_VM["DiscoverViewModel<br/>@HiltViewModel"]
        end

        subgraph SEARCH["feature:search"]
            SEARCH_UI["SearchScreen<br/>@Composable"]
            SEARCH_VM["SearchViewModel<br/>@HiltViewModel<br/>debounce(300ms)"]
        end

        subgraph DETAIL["feature:detail"]
            DETAIL_UI["DetailScreen<br/>@Composable"]
            DETAIL_VM["DetailViewModel<br/>@HiltViewModel"]
        end

        subgraph FAV["feature:favourites"]
            FAV_UI["FavouritesScreen<br/>@Composable"]
            FAV_VM["FavouritesViewModel<br/>@HiltViewModel"]
        end

        DISCOVER_UI --> DISCOVER_VM
        SEARCH_UI --> SEARCH_VM
        DETAIL_UI --> DETAIL_VM
        FAV_UI --> FAV_VM
    end

%% Navigation from NavHost to Screens
    NAV_HOST --> DISCOVER_UI
    NAV_HOST --> SEARCH_UI
    NAV_HOST --> DETAIL_UI
    NAV_HOST --> FAV_UI

%% ===== FOURTH ROW: Shared UI Components =====
    COMPONENTS["Shared Composables (core:ui)<br/>GameCard | GenreChip | RatingBar | SearchBar | StateWrapper"]
    COMPONENTS -.-> THEME
    DISCOVER_UI -.-> COMPONENTS
    SEARCH_UI -.-> COMPONENTS
    DETAIL_UI -.-> COMPONENTS
    FAV_UI -.-> COMPONENTS

%% ===== FIFTH ROW: Domain Layer =====
    subgraph DOMAIN["Domain Layer (core:model)"]
        direction LR
        GAME["Game / GameDetail<br/>@Serializable data class"]
        USER["User / Favourite<br/>@Serializable data class"]
        RESULT["Result<T><br/>Sealed Interface"]
    end

%% ViewModels → Domain Models
    DISCOVER_VM -.-> RESULT
    SEARCH_VM -.-> RESULT
    DETAIL_VM -.-> RESULT
    FAV_VM -.-> RESULT

%% ===== SIXTH ROW: Data Layer =====
    subgraph DATA["Data Layer"]
        direction TB

        subgraph CORE_DATA["core:data"]
            NETWORK["NetworkClient<br/>Retrofit"]
            REMOTE_DS["GameRemoteDataSource<br/>suspend fun"]
            GAME_REPO["GameRepository<br/>@Singleton"]
            USER_REPO["UserRepository<br/>@Singleton"]
            NETWORK --> REMOTE_DS
            REMOTE_DS --> GAME_REPO
        end

        subgraph CORE_DB["core:database"]
            ROOM_DB["AppDatabase<br/>@Database"]
            DAOS["GameDao | UserDao | FavouriteGameDao"]
            LOCAL_REPOS["GameLocalRepository | UserLocalRepository | FavouritesRepository"]
            ROOM_DB --> DAOS
            DAOS --> LOCAL_REPOS
        end

        GAME_REPO -->|"maps DTO →"| GAME
        USER_REPO -->|"maps DTO →"| USER
    end

%% ViewModels → Repository
    DISCOVER_VM --> GAME_REPO
    SEARCH_VM --> GAME_REPO
    DETAIL_VM --> GAME_REPO
    FAV_VM --> USER_REPO

%% ===== BOTTOM ROW: Hilt DI =====
    subgraph DI["DI Container (Hilt)"]
        direction LR
        HILT_GRAPH["Hilt Dependency Graph"]
        MODULES["NetworkModule | DatabaseModule | RepositoryModule"]
        VIEWMODEL_FACTORY["@HiltViewModel Factory"]

        HILT_GRAPH --> MODULES
        HILT_GRAPH --> VIEWMODEL_FACTORY
        MODULES --> GAME_REPO
        MODULES --> USER_REPO
        MODULES --> NETWORK
        MODULES --> ROOM_DB
        VIEWMODEL_FACTORY --> DISCOVER_VM
        VIEWMODEL_FACTORY --> SEARCH_VM
        VIEWMODEL_FACTORY --> DETAIL_VM
        VIEWMODEL_FACTORY --> FAV_VM
    end

%% Back-link: Data → DI (dependency injection)
    GAME_REPO -.->|"provided by"| MODULES
    USER_REPO -.->|"provided by"| MODULES
    NETWORK -.->|"provided by"| MODULES
    ROOM_DB -.->|"provided by"| MODULES

%% ===== STYLING =====
    classDef presentation fill:#4CAF50,stroke:#2E7D32,stroke-width:2px,color:white
    classDef domain fill:#2196F3,stroke:#1565C0,stroke-width:2px,color:white
    classDef data fill:#FF9800,stroke:#E65100,stroke-width:2px,color:white
    classDef ui fill:#9C27B0,stroke:#6A1B9A,stroke-width:2px,color:white
    classDef app fill:#F44336,stroke:#C62828,stroke-width:2px,color:white
    classDef di fill:#607D8B,stroke:#37474F,stroke-width:2px,color:white

    class DISCOVER_UI,DISCOVER_VM,SEARCH_UI,SEARCH_VM,DETAIL_UI,DETAIL_VM,FAV_UI,FAV_VM presentation
    class GAME,USER,RESULT domain
    class NETWORK,REMOTE_DS,GAME_REPO,USER_REPO,ROOM_DB,DAOS,LOCAL_REPOS data
    class THEME,COMPONENTS ui
    class ACTIVITY,NAV_HOST,BOTTOM_NAV,APP_CLASS app
    class HILT_GRAPH,MODULES,VIEWMODEL_FACTORY di
