# =============================================================================
# Release Keystore Configuration
# =============================================================================
#
# IMPORTANT: This file is a template. DO NOT commit the actual keystore or
# real passwords to version control!
#
# To configure release signing for production builds:
#
# 1. Create a keystore using keytool:
#    keytool -genkeypair -v -storetype PKCS12 \
#      -keyalg RSA -keysize 2048 \
#      -validity 10000 \
#      -keystore release-keystore.jks \
#      -alias release_key \
#      -storepass YOUR_STORE_PASSWORD \
#      -keypass YOUR_KEY_PASSWORD
#
# 2. Place the keystore file at: app/release-keystore.jks
#
# 3. Set environment variables or configure signing in build.gradle.kts:
#
#    Option A - Environment Variables (Recommended):
#    export RELEASE_KEYSTORE_PATH="app/release-keystore.jks"
#    export RELEASE_KEYSTORE_PASSWORD="your_store_password"
#    export RELEASE_KEY_ALIAS="release_key"
#    export RELEASE_KEY_PASSWORD="your_key_password"
#
#    Option B - Direct Configuration (Less Secure):
#    Uncomment and configure signingConfigs in build.gradle.kts
#
# 4. Build release:
#    ./gradlew assembleRelease
#
# =============================================================================

# Sample keystore info (REPLACE WITH ACTUAL VALUES)
KEYSTORE_PATH=app/release-keystore.jks
KEYSTORE_PASSWORD=change_me
KEY_ALIAS=release_key
KEY_PASSWORD=change_me

# Key generation details (reference only)
KEY_ALGORITHM=RSA
KEY_SIZE=2048
VALIDITY_DAYS=10000